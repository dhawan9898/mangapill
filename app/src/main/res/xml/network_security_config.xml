<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP has to stay allowed: self-hosted OPDS servers (Komga, Kavita, Suwayomi) are usually
     reached as http://192.168.x.x:port - addresses this file cannot list (it takes host names, not
     address ranges). Only system certificates are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
